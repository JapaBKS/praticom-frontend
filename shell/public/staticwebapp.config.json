{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/market/*", "/finance/*", "*.{js,css,json,svg,png,ico}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  },
  "routes": [
    {
      "route": "/*/assets/remoteEntry.js",
      "headers": { "Cache-Control": "no-cache" }
    }
  ]
}
